{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "DOM.OS desktop permissions",
  "windows": [
    "main",
    "domos-*"
  ],
  "permissions": [
    "core:default",
    "updater:default",
    "process:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-close"
  ]
}
